<?xml version="1.0" encoding="utf-8"?>
<!--
  J.A.R.V.I.S. — Android shell (Capacitor).

  Permission posture:
   - INTERNET   : required to reach the configured AI provider (and the
                  optional JARVIS backend host).
   - RECORD_AUDIO + CAMERA : runtime permissions requested lazily from the UI.
   - FOREGROUND_SERVICE + FOREGROUND_SERVICE_MICROPHONE : used ONLY by
     JarvisWakeService while the owner has “Hey JARVIS” monitoring enabled.
     The service shows a permanent notification, releases the microphone the
     moment monitoring is disabled, and never records ambient audio to disk.

  There is deliberately no:
   - AccessibilityService abuse or silent background recording.
   - PC-side phone control: phone actions execute through documented Android
     intents/sensors in JarvisNativePlugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility (Android 11+): the native bridge lists launchable apps
      so "open YouTube" can resolve a real installed package. Without this
      <queries> block PackageManager returns an empty list on API 30+.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!--
          Android 11+ package visibility: TextToSpeech and getVoices() must be
          able to enumerate TTS engines, otherwise voice output silently looks
          "unavailable" even when a system voice is installed.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- “Hey JARVIS” monitor. Microphone work happens only here, always
             behind the notification the service posts. -->
        <service
            android:name=".JarvisWakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wake-word monitoring is a microphone foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Microphone and camera are optional hardware: never filter the app out
         of Play/installation on devices that lack one of them. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- SharedPreferences/UI state only — explicit "never location/sms/etc." -->
</manifest>
